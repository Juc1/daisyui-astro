---
/**
 * @file DaisyCardTeaser.astro
 * @description Pure-prop DaisyUI teaser card component with 1:1 parity with Drupal SDC
 * `daisyui_sdc:daisy-card-teaser`.
 *
 * Designed for article grids, Views listings, and blog feeds with accessible stretched links,
 * categories, author/date metadata, media aspect ratios, and custom badge/icon positioning.
 */

export interface MediaProps {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
}

export interface Props {
  /** Card or article headline text */
  heading_text?: string;
  /** HTML heading level (2-6, default: 3) */
  level?: 2 | 3 | 4 | 5 | 6;
  /** Link destination URL */
  url?: string;
  /** Optional media thumbnail image */
  media?: MediaProps;
  /** Image caption overlay text */
  caption?: string;
  /** Media aspect ratio preset (default: "3:2") */
  aspect_ratio?: 'auto' | '16:9' | '4:3' | '1:1' | '3:2' | '2:1';
  /** Summary or excerpt text/HTML */
  text?: string;
  /** Category or tag label */
  category?: string;
  /** Date or metadata string (e.g. "Oct 25, 2026") */
  date?: string;
  /** Optional icon identifier or SVG */
  icon?: string;
  /** Placement of the icon within the card (default: "top-center") */
  icon_position?:
    | 'top-left'
    | 'top-center'
    | 'top-right'
    | 'title-start'
    | 'title-end'
    | 'bottom-right';
  /** Visual container style for icons (default: "plain") */
  icon_style?: 'plain' | 'badge';
  /** Center align title and body content (default: false) */
  is_text_centered?: boolean;
  /** Layout orientation (default: "vertical") */
  orientation?: 'vertical' | 'horizontal';
  /** Height stretching behavior (default: "full") */
  height?: 'auto' | 'full';
  /** Card frame style (default: "full") */
  style?: 'full' | 'framed' | 'border' | 'dash';
  /** Apply 10px top accent border (default: false) */
  border_top?: boolean;
  /** Color token for 10px top accent border (default: "primary") */
  border_top_color?: 'primary' | 'secondary' | 'accent' | 'neutral' | 'base-300';
  /** Background surface token (default: "default") */
  background?:
    | 'default'
    | 'base-200'
    | 'base-300'
    | 'primary'
    | 'secondary'
    | 'accent'
    | 'neutral'
    | 'transparent';
  /** Shadow elevation preset (default: "xl") */
  shadow?: 'none' | 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  /** Additional CSS utility classes */
  class?: string;
  /** SDC prop compatibility alias for class */
  card_classes?: string;
}

const {
  heading_text = 'Card Title',
  level = 3,
  url,
  media,
  caption,
  aspect_ratio = '3:2',
  text,
  category = 'Category / tag',
  date,
  icon,
  icon_position = 'top-center',
  icon_style = 'plain',
  is_text_centered = false,
  orientation = 'vertical',
  height = 'full',
  style = 'full',
  border_top = false,
  border_top_color = 'primary',
  background = 'default',
  shadow = 'xl',
  class: className = '',
  card_classes = '',
} = Astro.props;

// Heading tag selection
const HeadingTag = `h${level}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6';

// Surface backgrounds
const backgroundClasses: Record<string, string> = {
  default: 'bg-base-100 text-base-content',
  'base-200': 'bg-base-200 text-base-content',
  'base-300': 'bg-base-300 text-base-content',
  primary: 'bg-primary text-primary-content',
  secondary: 'bg-secondary text-secondary-content',
  accent: 'bg-accent text-accent-content',
  neutral: 'bg-neutral text-neutral-content',
  transparent: 'bg-transparent text-base-content',
};

// Aspect ratio mapping
const aspectRatioClasses: Record<string, string> = {
  auto: 'aspect-auto',
  '16:9': 'aspect-16/9',
  '4:3': 'aspect-4/3',
  '1:1': 'aspect-1/1',
  '3:2': 'aspect-3/2',
  '2:1': 'aspect-2/1',
};

// Border top colors
const borderTopColorClasses: Record<string, string> = {
  primary: 'border-t-primary',
  secondary: 'border-t-secondary',
  accent: 'border-t-accent',
  neutral: 'border-t-neutral',
  'base-300': 'border-t-base-300',
};

// Frame styles
const styleClasses: Record<string, string> = {
  full: '',
  framed: 'p-4 lg:p-6 gap-4',
  border: 'card-border',
  dash: 'card-dash',
};

// Shadow elevations
const shadowClasses: Record<string, string> = {
  none: 'shadow-none',
  sm: 'shadow-sm',
  md: 'shadow-md',
  lg: 'shadow-lg',
  xl: 'shadow-xl',
  '2xl': 'shadow-2xl',
};

// Outer container classes
const classes = [
  'card',
  'w-full',
  height === 'full' ? 'h-full' : 'self-start h-auto!',
  'group relative',
  'transition duration-300 hover:-translate-y-1 hover:shadow-2xl',
  orientation === 'horizontal' ? 'md:card-side' : '',
  styleClasses[style] || '',
  backgroundClasses[background] || backgroundClasses.default,
  shadow === 'none' ? 'shadow-none' : shadowClasses[shadow] || 'shadow-xl',
  border_top ? `border-t-[10px] ${borderTopColorClasses[border_top_color] || 'border-t-primary'}` : '',
  className,
  card_classes,
]
  .filter(Boolean)
  .join(' ');

// Media figure classes
const isAutoAspect = aspect_ratio === 'auto';
const figureClasses = [
  'relative overflow-hidden shrink-0 w-full',
  style === 'framed' ? 'rounded-lg' : '',
  orientation === 'horizontal' ? 'md:w-auto md:max-w-xs lg:max-w-sm' : '',
  aspectRatioClasses[aspect_ratio] || 'aspect-3/2',
]
  .filter(Boolean)
  .join(' ');

const imgClasses = isAutoAspect ? 'w-full h-auto' : 'object-cover w-full h-full transition duration-300 group-hover:scale-105';
---

<div class={classes}>
  {
    media?.src && (
      <figure class={figureClasses}>
        <img
          src={media.src}
          alt={media.alt || ''}
          class={imgClasses}
          width={media.width}
          height={media.height}
          loading="lazy"
        />
        {caption && (
          <figcaption class="pointer-events-none absolute bottom-2 left-2 z-10 line-clamp-2 max-w-[calc(100%-1rem)] rounded bg-black/60 px-2.5 py-1 text-xs text-white backdrop-blur-xs">
            {caption}
          </figcaption>
        )}
      </figure>
    )
  }

  <div class={`card-body ${height === 'full' ? 'flex-1' : ''} ${is_text_centered ? 'items-center text-center' : 'items-start text-left'}`}>
    {
      category && (
        <span class="badge badge-sm badge-soft badge-primary font-medium tracking-wide uppercase">
          {category}
        </span>
      )
    }

    <HeadingTag class="card-title text-xl font-bold tracking-tight">
      {
        url ? (
          <a href={url} class="after:absolute after:inset-0 focus:outline-hidden hover:text-primary">
            {icon && icon_position === 'title-start' && <span class="mr-1.5">{icon}</span>}
            {heading_text}
            {icon && icon_position === 'title-end' && <span class="ml-1.5">{icon}</span>}
          </a>
        ) : (
          <>
            {icon && icon_position === 'title-start' && <span class="mr-1.5">{icon}</span>}
            {heading_text}
            {icon && icon_position === 'title-end' && <span class="ml-1.5">{icon}</span>}
          </>
        )
      }
    </HeadingTag>

    {text && <div class="text-sm opacity-80 leading-relaxed" set:html={text} />}

    {
      date && (
        <div class="mt-auto pt-3 text-xs opacity-60 flex items-center gap-1.5">
          <span>{date}</span>
        </div>
      )
    }
  </div>
</div>
