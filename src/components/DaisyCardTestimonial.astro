---
/**
 * @file DaisyCardTestimonial.astro
 * @description DaisyUI testimonial card component with 1:1 parity with Drupal SDC
 * `daisyui_sdc:daisy-card-testimonial`.
 *
 * Supports quotation marks watermark, avatar image, citation credentials with links,
 * customizable quote sizes, vertical alignment modes (center, center-quote, spread),
 * and DaisyUI theme overrides.
 */

export interface MediaProps {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
}

export interface Props {
  /** Testimonial quote text/HTML */
  rich_text?: string;
  /** Name of the person providing the quote */
  cite_name?: string;
  /** Role, company, or credential title */
  cite_text?: string;
  /** Optional link URL for the citation/author */
  cite_url?: string;
  /** Author avatar portrait image object */
  media?: MediaProps;
  /** Content horizontal alignment (default: "center") */
  align?: 'center' | 'left';
  /** Vertical alignment logic when stretched (default: "center") */
  vertical_align?: 'center' | 'center-quote' | 'spread';
  /** Card height behavior (default: "full") */
  height?: 'full' | 'auto';
  /** Quote text size preset (default: "xl") */
  quote_size?: 'base' | 'lg' | 'xl' | '2xl';
  /** Show decorative quotation mark SVGs (default: true) */
  show_quote_marks?: boolean;
  /** Background surface color token (default: "base-200") */
  background?:
    | 'white'
    | 'default'
    | 'base-200'
    | 'base-300'
    | 'primary'
    | 'secondary'
    | 'accent'
    | 'neutral'
    | 'transparent';
  /** Border style modifier (default: "default") */
  style?: 'default' | 'border' | 'dash';
  /** Card padding size (default: "lg") */
  size?: 'sm' | 'md' | 'lg' | 'xl';
  /** Shadow elevation preset (default: "none") */
  shadow?: 'none' | 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  /** Theme override token (data-theme) */
  data_theme?: string;
  /** Margin bottom preset */
  margin_block_end?: '0' | '8' | '20' | '32' | '48' | '64' | '96' | '128';
  /** Additional CSS utility classes */
  class?: string;
}

const {
  rich_text = '<p>My career’s guidance was crucial in helping me understand the tech industry landscape and ultimately secure my role.</p>',
  cite_name = 'Isiah Julio',
  cite_text = 'Engineer, Technical Services',
  cite_url,
  media,
  align = 'center',
  vertical_align = 'center',
  height = 'full',
  quote_size = 'xl',
  show_quote_marks = true,
  background = 'base-200',
  style = 'default',
  size = 'lg',
  shadow = 'none',
  data_theme,
  margin_block_end = '0',
  class: className = '',
} = Astro.props;

// Surface backgrounds
const backgroundClasses: Record<string, string> = {
  white: 'bg-white text-black',
  default: 'bg-base-100 text-base-content',
  'base-200': 'bg-base-200 text-base-content',
  'base-300': 'bg-base-300 text-base-content',
  primary: 'bg-primary text-primary-content',
  secondary: 'bg-secondary text-secondary-content',
  accent: 'bg-accent text-accent-content',
  neutral: 'bg-neutral text-neutral-content',
  transparent: 'bg-transparent text-base-content',
};

// Border styles
const styleClasses: Record<string, string> = {
  default: '',
  border: 'card-border',
  dash: 'card-dash',
};

// Padding sizes
const sizeClasses: Record<string, string> = {
  sm: 'card-sm',
  md: '',
  lg: 'card-lg',
  xl: 'card-xl',
};

// Shadows
const shadowClasses: Record<string, string> = {
  none: 'shadow-none',
  sm: 'shadow-sm',
  md: 'shadow-md',
  lg: 'shadow-lg',
  xl: 'shadow-xl',
  '2xl': 'shadow-2xl',
};

// Height
const heightClasses: Record<string, string> = {
  full: 'h-full',
  auto: 'self-start h-auto',
};

// Quote text sizes
const quoteSizeClasses: Record<string, string> = {
  base: 'text-base',
  lg: 'text-lg',
  xl: 'text-xl',
  '2xl': 'text-2xl',
};

// Margin bottom
const marginClasses: Record<string, string> = {
  '0': 'mb-0',
  '8': 'mb-2',
  '20': 'mb-5',
  '32': 'mb-6 md:mb-7 xl:mb-8',
  '48': 'mb-8 md:mb-10 xl:mb-12',
  '64': 'mb-10 md:mb-13 xl:mb-16',
  '96': 'mb-16 md:mb-20 xl:mb-24',
  '128': 'mb-20 md:mb-24 xl:mb-32',
};

// Vertical classes for blockquote
const blockquoteVerticalClasses: Record<string, string> = {
  center: 'justify-center',
  'center-quote': 'justify-between',
  spread: 'justify-between',
};

const quoteVerticalClasses: Record<string, string> = {
  center: '',
  'center-quote': 'my-auto',
  spread: 'grow',
};

// Assemble outer classes
const classes = [
  'card',
  'relative w-full',
  heightClasses[height] || 'h-full',
  backgroundClasses[background] || backgroundClasses['base-200'],
  styleClasses[style] || '',
  sizeClasses[size] || 'card-lg',
  shadowClasses[shadow] || 'shadow-none',
  marginClasses[margin_block_end] || 'mb-0',
  className,
]
  .filter(Boolean)
  .join(' ');

const blockquoteClasses = [
  'relative z-10 flex flex-1 flex-col gap-6',
  show_quote_marks ? 'px-2 py-8' : '',
  align === 'center' ? 'items-center text-center' : 'items-start text-left',
  blockquoteVerticalClasses[vertical_align] || 'justify-center',
]
  .filter(Boolean)
  .join(' ');

const quoteClasses = [
  quoteVerticalClasses[vertical_align] || '',
  quoteSizeClasses[quote_size] || 'text-xl',
  'text-inherit italic [&_p]:mb-3 [&_p:last-child]:mb-0',
]
  .filter(Boolean)
  .join(' ');

const footerClasses = [
  'flex flex-row items-center gap-4 text-center text-base font-bold',
  align === 'center' ? 'justify-center' : 'justify-start',
].join(' ');
---

<div class={classes} data-theme={data_theme}>
  {
    show_quote_marks && (
      <>
        <svg
          class="pointer-events-none absolute start-4 top-4 size-16 text-current opacity-10"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M7.39762 10.3C7.39762 11.0733 7.14888 11.7 6.6514 12.18C6.15392 12.6333 5.52552 12.86 4.76621 12.86C3.84979 12.86 3.09047 12.5533 2.48825 11.94C1.91222 11.3266 1.62421 10.4467 1.62421 9.29999C1.62421 8.07332 1.96459 6.87332 2.64535 5.69999C3.35231 4.49999 4.33418 3.55332 5.59098 2.85999L6.4943 4.25999C5.81354 4.73999 5.26369 5.27332 4.84476 5.85999C4.45201 6.44666 4.19017 7.12666 4.05926 7.89999C4.29491 7.79332 4.56983 7.73999 4.88403 7.73999C5.61716 7.73999 6.21938 7.97999 6.69067 8.45999C7.16197 8.93999 7.39762 9.55333 7.39762 10.3ZM14.6242 10.3C14.6242 11.0733 14.3755 11.7 13.878 12.18C13.3805 12.6333 12.7521 12.86 11.9928 12.86C11.0764 12.86 10.3171 12.5533 9.71484 11.94C9.13881 11.3266 8.85079 10.4467 8.85079 9.29999C8.85079 8.07332 9.19117 6.87332 9.87194 5.69999C10.5789 4.49999 11.5608 3.55332 12.8176 2.85999L13.7209 4.25999C13.0401 4.73999 12.4903 5.27332 12.0713 5.85999C11.6786 6.44666 11.4168 7.12666 11.2858 7.89999C11.5215 7.79332 11.7964 7.73999 12.1106 7.73999C12.8437 7.73999 13.446 7.97999 13.9173 8.45999C14.3886 8.93999 14.6242 9.55333 14.6242 10.3Z"
            fill="currentColor"
          />
        </svg>
        <svg
          class="pointer-events-none absolute end-4 bottom-4 size-16 rotate-180 text-current opacity-10"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M7.39762 10.3C7.39762 11.0733 7.14888 11.7 6.6514 12.18C6.15392 12.6333 5.52552 12.86 4.76621 12.86C3.84979 12.86 3.09047 12.5533 2.48825 11.94C1.91222 11.3266 1.62421 10.4467 1.62421 9.29999C1.62421 8.07332 1.96459 6.87332 2.64535 5.69999C3.35231 4.49999 4.33418 3.55332 5.59098 2.85999L6.4943 4.25999C5.81354 4.73999 5.26369 5.27332 4.84476 5.85999C4.45201 6.44666 4.19017 7.12666 4.05926 7.89999C4.29491 7.79332 4.56983 7.73999 4.88403 7.73999C5.61716 7.73999 6.21938 7.97999 6.69067 8.45999C7.16197 8.93999 7.39762 9.55333 7.39762 10.3ZM14.6242 10.3C14.6242 11.0733 14.3755 11.7 13.878 12.18C13.3805 12.6333 12.7521 12.86 11.9928 12.86C11.0764 12.86 10.3171 12.5533 9.71484 11.94C9.13881 11.3266 8.85079 10.4467 8.85079 9.29999C8.85079 8.07332 9.19117 6.87332 9.87194 5.69999C10.5789 4.49999 11.5608 3.55332 12.8176 2.85999L13.7209 4.25999C13.0401 4.73999 12.4903 5.27332 12.0713 5.85999C11.6786 6.44666 11.4168 7.12666 11.2858 7.89999C11.5215 7.79332 11.7964 7.73999 12.1106 7.73999C12.8437 7.73999 13.446 7.97999 13.9173 8.45999C14.3886 8.93999 14.6242 9.55333 14.6242 10.3Z"
            fill="currentColor"
          />
        </svg>
      </>
    )
  }

  <div class="card-body flex-1">
    <blockquote class={blockquoteClasses} cite={cite_url && cite_url !== 'No URL' ? cite_url : undefined}>
      {rich_text && <div class={quoteClasses} set:html={rich_text} />}

      {
        (cite_name || cite_text || media?.src) && (
          <footer class={footerClasses}>
            {media?.src && (
              <div class="avatar shrink-0">
                <div class="w-15 rounded-full overflow-hidden">
                  <img
                    src={media.src}
                    alt={media.alt || cite_name || ''}
                    class="object-cover w-full h-full"
                    width={media.width || 60}
                    height={media.height || 60}
                  />
                </div>
              </div>
            )}
            <div>
              {cite_name && <div>{cite_name}</div>}
              {cite_text && (
                <cite class="font-normal not-italic">
                  {cite_url && cite_url !== 'No URL' ? (
                    <a href={cite_url} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:opacity-80">
                      {cite_text}
                    </a>
                  ) : (
                    <span class="text-base opacity-85">{cite_text}</span>
                  )}
                </cite>
              )}
            </div>
          </footer>
        )
      }
    </blockquote>
  </div>
</div>
