---
/**
 * @file DaisyCardWithSlots.astro
 * @description Flexible DaisyUI card component with 1:1 parity with Drupal SDC
 * `daisyui_sdc:daisy-card-with-slots`.
 *
 * Supports vertical & horizontal orientations, image aspect ratio presets,
 * 10px accent top borders, image overlay (image-full) mode, surface backgrounds,
 * elevations, and slots for main content and card actions.
 */

export interface MediaProps {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
}

export interface Props {
  /** Optional media image object */
  media?: MediaProps;
  /** Image caption overlay text */
  caption?: string;
  /** Media aspect ratio preset (default: "auto") */
  aspect_ratio?: 'auto' | '16:9' | '4:3' | '1:1' | '3:2' | '2:1';
  /** Center align title and body content (default: false) */
  is_text_centered?: boolean;
  /** Layout orientation (default: "vertical") */
  orientation?: 'vertical' | 'horizontal';
  /** Height stretching behavior (default: "auto") */
  height?: 'auto' | 'full';
  /** Visual card frame style (default: "full") */
  style?: 'full' | 'framed' | 'border' | 'dash' | 'overlay';
  /** Card padding size token (default: "md") */
  size?: 'sm' | 'md' | 'lg' | 'xl';
  /** Background surface color token (default: "default") */
  background?:
    | 'default'
    | 'base-200'
    | 'base-300'
    | 'primary'
    | 'secondary'
    | 'accent'
    | 'neutral'
    | 'transparent';
  /** Shadow elevation preset (default: "xl") */
  shadow?: 'none' | 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  /** Apply prominent 10px top accent border (default: false) */
  border_top?: boolean;
  /** Color token for the 10px top accent border (default: "primary") */
  border_top_color?: 'primary' | 'secondary' | 'accent' | 'neutral' | 'base-300';
  /** Additional CSS utility classes */
  class?: string;
  /** SDC prop compatibility alias for class */
  card_classes?: string;
}

const {
  media,
  caption,
  aspect_ratio = 'auto',
  is_text_centered = false,
  orientation = 'vertical',
  height = 'auto',
  style = 'full',
  size = 'md',
  background = 'default',
  shadow = 'xl',
  border_top = false,
  border_top_color = 'primary',
  class: className = '',
  card_classes = '',
} = Astro.props;

// Surface backgrounds
const backgroundClasses: Record<string, string> = {
  default: 'bg-base-100 text-base-content',
  'base-200': 'bg-base-200 text-base-content',
  'base-300': 'bg-base-300 text-base-content',
  primary: 'bg-primary text-primary-content',
  secondary: 'bg-secondary text-secondary-content',
  accent: 'bg-accent text-accent-content',
  neutral: 'bg-neutral text-neutral-content',
  transparent: 'bg-transparent text-base-content',
};

// Orientation
const orientationClasses: Record<string, string> = {
  vertical: '',
  horizontal: 'md:card-side',
};

// Frame styles
const styleClasses: Record<string, string> = {
  full: '',
  framed: 'p-4 lg:p-6 gap-4',
  border: 'card-border',
  dash: 'card-dash',
  overlay: 'image-full',
};

// Sizing
const sizeClasses: Record<string, string> = {
  sm: 'card-sm',
  md: '',
  lg: 'card-lg',
  xl: 'card-xl',
};

// Shadows
const shadowClasses: Record<string, string> = {
  none: 'shadow-none',
  sm: 'shadow-sm',
  md: 'shadow-md',
  lg: 'shadow-lg',
  xl: 'shadow-xl',
  '2xl': 'shadow-2xl',
};

// Aspect ratios
const aspectRatioClasses: Record<string, string> = {
  auto: 'aspect-auto',
  '16:9': 'aspect-16/9',
  '4:3': 'aspect-4/3',
  '1:1': 'aspect-1/1',
  '3:2': 'aspect-3/2',
  '2:1': 'aspect-2/1',
};

// Top border colors
const borderTopColorClasses: Record<string, string> = {
  primary: 'border-t-primary',
  secondary: 'border-t-secondary',
  accent: 'border-t-accent',
  neutral: 'border-t-neutral',
  'base-300': 'border-t-base-300',
};

// Outer card classes
const classes = [
  'card',
  'w-full',
  height === 'full' ? 'h-full' : 'self-start h-auto!',
  'group relative',
  'transition duration-300',
  orientationClasses[orientation] || '',
  styleClasses[style] || '',
  backgroundClasses[background] || backgroundClasses.default,
  sizeClasses[size] || '',
  shadow === 'none' ? 'shadow-none' : shadowClasses[shadow] || 'shadow-xl',
  border_top ? `border-t-[10px] ${borderTopColorClasses[border_top_color] || 'border-t-primary'}` : '',
  className,
  card_classes,
]
  .filter(Boolean)
  .join(' ');

// Figure classes
const isAutoAspect = aspect_ratio === 'auto';
const figureClasses = [
  'relative overflow-hidden shrink-0 w-full',
  style === 'framed' ? 'rounded-lg' : '',
  orientation === 'horizontal' ? 'md:w-auto md:max-w-xs lg:max-w-sm' : '',
  aspectRatioClasses[aspect_ratio] || 'aspect-auto',
]
  .filter(Boolean)
  .join(' ');

const imgClasses = isAutoAspect ? 'w-full h-auto' : 'object-cover w-full h-full';
---

<div class={classes}>
  {
    media?.src && (
      <figure class={figureClasses}>
        <img
          src={media.src}
          alt={media.alt || ''}
          class={imgClasses}
          width={media.width}
          height={media.height}
          loading="lazy"
        />
        {caption && (
          <figcaption class="pointer-events-none absolute bottom-2 left-2 z-10 line-clamp-2 max-w-[calc(100%-1rem)] rounded bg-black/60 px-2.5 py-1 text-xs text-white backdrop-blur-xs">
            {caption}
          </figcaption>
        )}
      </figure>
    )
  }

  <div class={`card-body ${height === 'full' ? 'flex-1' : ''} ${is_text_centered ? 'items-center text-center' : 'items-start text-left'}`}>
    <div class="@container flex w-full flex-col gap-2">
      <slot />
    </div>

    {
      Astro.slots.has('actions') && (
        <div class={`card-actions empty:hidden ${is_text_centered ? 'justify-center' : 'justify-end'} mt-auto pt-2`}>
          <slot name="actions" />
        </div>
      )
    }
  </div>
</div>
