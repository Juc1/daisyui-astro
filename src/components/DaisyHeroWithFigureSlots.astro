---
/**
 * @file DaisyHeroWithFigureSlots.astro
 * @description Composable two-column DaisyUI hero with figure and open content slot,
 * with 1:1 parity with Drupal SDC `daisyui_sdc:daisy-hero-with-figure-slots`.
 *
 * Provides a responsive two-column hero layout with figure/media on one side
 * and an open content slot on the other for arbitrary components, forms, and headings.
 */

export interface MediaProps {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
}

export interface Props {
  /** Side media image object */
  media?: MediaProps;
  /** Media position on desktop (default: "left") */
  media_position?: 'left' | 'right';
  /** Width distribution between media and content (default: "1:1") */
  layout_ratio?: '1:1' | '1:2' | '2:1';
  /** Mobile stacking order (default: "media-first") */
  mobile_order?: 'media-first' | 'content-first';
  /** Media aspect ratio preset (default: "auto") */
  media_aspect_ratio?: 'auto' | '1:1' | '4:3' | '3:2' | '16:9';
  /** Media corner rounding preset (default: "medium") */
  media_radius?: 'none' | 'small' | 'medium' | 'large' | 'full';
  /** Background surface color token (default: "base-200") */
  background_color?:
    | 'base-200'
    | 'base-100'
    | 'base-300'
    | 'neutral'
    | 'primary'
    | 'transparent';
  /** Minimum container height preset (default: "medium") */
  min_height?: 'screen' | 'large' | 'medium' | 'small' | 'auto';
  /** Theme override token (data-theme) */
  data_theme?: string;
  /** Additional CSS utility classes */
  class?: string;
}

const {
  media,
  media_position = 'left',
  layout_ratio = '1:1',
  mobile_order = 'media-first',
  media_aspect_ratio = 'auto',
  media_radius = 'medium',
  background_color = 'base-200',
  min_height = 'medium',
  data_theme,
  class: className = '',
} = Astro.props;

const isMediaRight = media_position === 'right';
const isMobileReverse = mobile_order === 'content-first';

// Height presets
const heightMap: Record<string, string> = {
  screen: 'min-h-screen',
  large: 'min-h-[70vh]',
  medium: 'min-h-[50vh]',
  small: 'min-h-[35vh]',
  auto: 'min-h-fit py-12 md:py-20',
};

// Background colors
const bgMap: Record<string, string> = {
  'base-200': 'bg-base-200 text-base-content',
  'base-100': 'bg-base-100 text-base-content',
  'base-300': 'bg-base-300 text-base-content',
  neutral: 'bg-neutral text-neutral-content',
  primary: 'bg-primary text-primary-content',
  transparent: 'bg-transparent text-base-content',
};

// Aspect ratios
const aspectMap: Record<string, string> = {
  '1:1': 'aspect-1/1',
  '4:3': 'aspect-4/3',
  '3:2': 'aspect-3/2',
  '16:9': 'aspect-16/9',
};

// Corner rounding
const radiusMap: Record<string, string> = {
  none: 'rounded-none',
  small: 'rounded-sm',
  medium: 'rounded-2xl',
  large: 'rounded-3xl',
  full: 'rounded-full',
};

// Split ratios
const splitRatios: Record<string, { media: string; content: string }> = {
  '1:1': { media: 'lg:flex-1 lg:basis-1/2', content: 'lg:flex-1 lg:basis-1/2' },
  '1:2': { media: 'lg:flex-1 lg:basis-1/3', content: 'lg:flex-1 lg:basis-2/3' },
  '2:1': { media: 'lg:flex-1 lg:basis-2/3', content: 'lg:flex-1 lg:basis-1/3' },
};
const activeSplit = splitRatios[layout_ratio] || splitRatios['1:1'];

// Content layout classes
const contentLayoutClasses = `${isMobileReverse ? 'flex-col-reverse' : 'flex-col'} ${isMediaRight ? 'lg:flex-row-reverse' : 'lg:flex-row'} gap-8 lg:gap-16`;

const classes = [
  'hero',
  'not-prose',
  'relative',
  'w-full',
  'overflow-hidden',
  heightMap[min_height] || 'min-h-[50vh]',
  bgMap[background_color] || bgMap['base-200'],
  className,
]
  .filter(Boolean)
  .join(' ');
---

<div class={classes} data-theme={data_theme && data_theme !== 'default' ? data_theme : undefined}>
  <div class={`hero-content max-w-none w-full px-4 py-8 md:py-12 ${contentLayoutClasses}`}>
    {
      media?.src && (
        <div class={`shrink-0 w-full ${activeSplit.media}`}>
          <div class={`w-full overflow-hidden shadow-2xl ${radiusMap[media_radius] || 'rounded-2xl'} ${aspectMap[media_aspect_ratio] || ''}`}>
            <img
              src={media.src}
              alt={media.alt || ''}
              class={`w-full ${media_aspect_ratio === 'auto' ? 'h-auto' : 'h-full'} object-cover`}
              width={media.width}
              height={media.height}
              loading="eager"
            />
          </div>
        </div>
      )
    }

    <div class={`flex flex-col gap-4 md:gap-6 items-start text-left ${activeSplit.content} w-full`}>
      <slot />
    </div>
  </div>
</div>
