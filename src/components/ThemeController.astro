---
/**
 * @file ThemeController.astro
 * @description Universal DaisyUI Theme Controller component with 1:1 parity with
 * Drupal SDC `daisyui_sdc:theme_controller`.
 *
 * Supports toggle, checkbox, swap, toggle-text, toggle-icons, radio-input, radio-button,
 * and dropdown theme picker UX variants.
 */

export interface ThemeItem {
  value: string;
  label: string;
}

export interface Props {
  /** Controller UX variant style (default: "toggle") */
  variant?:
    | 'toggle'
    | 'checkbox'
    | 'swap'
    | 'toggle-text'
    | 'toggle-icons'
    | 'toggle-icons-inside'
    | 'toggle-custom-colors'
    | 'radio-input'
    | 'radio-button'
    | 'dropdown';
  /** Target theme machine name for binary toggles (default: "synthwave") */
  theme_value?: string;
  /** HTML radio group name for radio/dropdown variants (default: "theme-radios") */
  name?: string;
  /** Label for dropdown trigger button (default: "Theme") */
  dropdown_label?: string;
  /** Array of available theme options for list/dropdown variants */
  themes?: ThemeItem[];
  /** Additional CSS utility classes */
  class?: string;
}

const defaultThemes: ThemeItem[] = [
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
  { value: 'synthwave', label: 'Synthwave' },
  { value: 'retro', label: 'Retro' },
  { value: 'cyberpunk', label: 'Cyberpunk' },
  { value: 'valentine', label: 'Valentine' },
  { value: 'aqua', label: 'Aqua' },
];

const {
  variant = 'toggle',
  theme_value = 'synthwave',
  name = 'theme-radios',
  dropdown_label = 'Theme',
  themes = defaultThemes,
  class: className = '',
} = Astro.props;
---

{
  variant === 'toggle' && (
    <input type="checkbox" value={theme_value} class={`toggle theme-controller ${className}`} />
  )
}

{
  variant === 'checkbox' && (
    <input type="checkbox" value={theme_value} class={`checkbox theme-controller ${className}`} />
  )
}

{
  variant === 'swap' && (
    <label class={`swap swap-rotate ${className}`}>
      <input type="checkbox" class="theme-controller" value={theme_value} />
      {/* Sun icon */}
      <svg class="swap-off h-10 w-10 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z" />
      </svg>
      {/* Moon icon */}
      <svg class="swap-on h-10 w-10 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z" />
      </svg>
    </label>
  )
}

{
  variant === 'toggle-text' && (
    <label class={`flex cursor-pointer gap-2 items-center ${className}`}>
      <span class="label-text">Default</span>
      <input type="checkbox" value={theme_value} class="toggle theme-controller" />
      <span class="label-text">{theme_value}</span>
    </label>
  )
}

{
  variant === 'toggle-icons' && (
    <label class={`flex cursor-pointer gap-2 items-center ${className}`}>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5" />
        <path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
      </svg>
      <input type="checkbox" value={theme_value} class="toggle theme-controller" />
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </label>
  )
}

{
  variant === 'radio-input' && (
    <fieldset class={`flex flex-col gap-2 ${className}`}>
      {themes.map((theme, idx) => (
        <label class="flex gap-2 cursor-pointer items-center">
          <input
            type="radio"
            name={name}
            value={theme.value}
            class="radio radio-sm theme-controller"
            checked={idx === 0}
          />
          <span class="text-sm">{theme.label}</span>
        </label>
      ))}
    </fieldset>
  )
}

{
  variant === 'radio-button' && (
    <div class={`join join-vertical ${className}`}>
      {themes.map((theme, idx) => (
        <input
          type="radio"
          name={name}
          class="btn theme-controller join-item"
          aria-label={theme.label}
          value={theme.value}
          checked={idx === 0}
        />
      ))}
    </div>
  )
}

{
  variant === 'dropdown' && (
    <div class={`dropdown ${className}`}>
      <div tabindex="0" role="button" class="btn m-1">
        {dropdown_label}
        <svg width="12px" height="12px" class="inline-block h-2 w-2 fill-current opacity-60" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2048 2048">
          <path d="M1799 349l242 241-1017 1017L7 590l242-241 775 775 775-775z" />
        </svg>
      </div>
      <ul tabindex="-1" class="dropdown-content bg-base-300 rounded-box z-10 w-52 p-2 shadow-2xl">
        {themes.map((theme, idx) => (
          <li>
            <input
              type="radio"
              name={name}
              class="theme-controller w-full btn btn-sm btn-block btn-ghost justify-start"
              aria-label={theme.label}
              value={theme.value}
              checked={idx === 0}
            />
          </li>
        ))}
      </ul>
    </div>
  )
}
